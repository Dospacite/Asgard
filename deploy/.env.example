# Where you will reach the control plane. Its host also becomes the Traefik
# router rule for the UI and the MCP endpoint.
ASGARD_PUBLIC_URL=https://asgard.apps.example.com

# The wildcard zone imported projects get hostnames under. Point *.<this> at
# the host in DNS. It also decides HSTS defaults: names inside this zone get
# includeSubDomains and preload, names outside it get a plain max-age.
ASGARD_DOMAIN=apps.example.com

# Contact address Let's Encrypt uses for expiry notices. Required.
ASGARD_ACME_EMAIL=you@example.com

# IANA timezone for displayed timestamps.
ASGARD_TIMEZONE=UTC

# Leave true for any deployment reachable over the network.
ASGARD_SECURE_COOKIES=true

# How often stored Git credentials are re-proven against their repositories
# with git ls-remote. 0 disables the sweep.
ASGARD_CREDENTIAL_VERIFY_HOURS=6

# Storage reclamation. Asgard tags an image per service per release and caches
# every build layer, so these bound what it keeps.
#   KEEP_RELEASE_IMAGES is also how far back a rollback can reach.
#   RECLAIM_HOURS=0 leaves disk management entirely to you.
ASGARD_KEEP_RELEASE_IMAGES=3
ASGARD_BUILD_CACHE_GB=2
ASGARD_RECLAIM_HOURS=12

# Optional: override the control-plane hostname if it is not the host of
# ASGARD_PUBLIC_URL.
# ASGARD_CONTROL_HOSTNAME=asgard.apps.example.com

# Optional: the host-loopback port the control plane is published on, for a host
# where 8080 is already in use. Traefik fronts it either way, so this is only
# about which port is free.
# ASGARD_CONTROL_PORT=8080

# The log collector's query UI. Grafana is the only part of the collector that
# is reachable from the internet, and it authenticates with this password. Loki
# has no route and no published port at all: the control plane pushes to it and
# Grafana reads from it, both over the management network inside this Compose
# project. Point the hostname at the wildcard zone above, or at any name whose
# DNS resolves to this host.
ASGARD_GRAFANA_HOSTNAME=grafana.apps.example.com
ASGARD_GRAFANA_ADMIN_PASSWORD=change-me-before-you-deploy

# Container log shipping. The control plane tails every running managed
# container and pushes what it reads to ASGARD_LOG_SINK_URL, which must speak
# Loki's push API. An empty value turns shipping off entirely.
#   INTERVAL is how long a service's output may sit uncollected.
#   LOOKBACK bounds the first read of a container that has no checkpoint yet.
#   BATCH_KB caps one push; a burst larger than this is sent over several.
ASGARD_LOG_SINK_URL=http://loki:3100
ASGARD_LOG_SHIP_INTERVAL_SECONDS=15
ASGARD_LOG_SHIP_LOOKBACK_SECONDS=300
ASGARD_LOG_SHIP_BATCH_KB=1024
